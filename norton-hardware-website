<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Norton Hardware</title>
  <meta name="description" content="Norton Hardware – Quality tools, building materials, and expert advice for every project." />
  <style>
    :root {
      --primary: #1f2937; /* slate-800 */
      --accent: #f59e0b;  /* amber-500 */
      --light: #f9fafb;   /* gray-50 */
      --dark: #111827;    /* gray-900 */
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--primary);
      background: var(--light);
      line-height: 1.6;
    }

    header {
      background: var(--dark);
      color: white;
      padding: 1.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    header h1 {
      margin: 0;
      font-size: 1.5rem;
      letter-spacing: 0.5px;
    }

    nav a {
      color: white;
      margin-left: 1.5rem;
      text-decoration: none;
      font-weight: 500;
    }

    nav a:hover { color: var(--accent); }

    .hero {
      background: linear-gradient(rgba(17,24,39,0.7), rgba(17,24,39,0.7)), url('https://images.unsplash.com/photo-1581091870627-3c5d1b6c2a8d') center/cover no-repeat;
      color: white;
      padding: 5rem 2rem;
      text-align: center;
    }

    .hero h2 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .hero p {
      max-width: 700px;
      margin: 0 auto 2rem;
      font-size: 1.1rem;
    }

    .btn {
      background: var(--accent);
      color: var(--dark);
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
    }

    .btn:hover { opacity: 0.9; }

    section {
      padding: 4rem 2rem;
      max-width: 1100px;
      margin: auto;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .card {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

    .card h3 { margin-top: 0; }

    .about {
      background: #ffffff;
      border-radius: 16px;
      padding: 3rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    footer {
      background: var(--dark);
      color: #d1d5db;
      text-align: center;
      padding: 2rem;
      font-size: 0.9rem;
    }

    footer strong { color: white; }

    @media (max-width: 600px) {
      header { flex-direction: column; align-items: flex-start; }
      nav { margin-top: 1rem; }
      nav a { margin-left: 0; margin-right: 1rem; }
    }
  </style>
</head>
<body>

  <header>
    <h1>Norton Hardware</h1>
    <nav>
      <a href="#products">Products</a>
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Built for Builders. Trusted by Pros.</h2>
    <p>Your local source for reliable tools, quality materials, and honest advice—helping you get the job done right the first time.</p>
    <a href="#products" class="btn">Shop Our Products</a>
  </section>

  <section id="products">
    <h2>Materials</h2>

    <div class="tabs">
      <button class="tab active" onclick="openTab(event, 'tools')">Tools</button>
      <button class="tab" onclick="openTab(event, 'lumber')">Lumber</button>
      <button class="tab" onclick="openTab(event, 'fasteners')">Fasteners</button>
      <button class="tab" onclick="openTab(event, 'paint')">Paint</button>
      <button class="tab" onclick="openTab(event, 'electrical')">Electrical</button>
      <button class="tab" onclick="openTab(event, 'plumbing')">Plumbing</button>
    </div>

    <div id="tools" class="tab-content active">
      <div class="card"><h3>Hand & Power Tools</h3><p>Professional-grade tools for construction, repair, and DIY projects.</p></div>
    </div>

    <div id="lumber" class="tab-content">
      <div class="card"><h3>Lumber & Sheet Goods</h3><p>Quality wood products cut and stocked for reliability and strength.</p></div>
    </div>

    <div id="fasteners" class="tab-content">
      <div class="card"><h3>Nails, Screws & Bolts</h3><p>A full range of fasteners for every application.</p></div>
    </div>

    <div id="paint" class="tab-content">
      <div class="card"><h3>Paint & Finishes</h3><p>Interior and exterior paints, stains, and protective coatings.</p></div>
    </div>

    <div id="electrical" class="tab-content">
      <div class="card"><h3>Electrical Supplies</h3><p>Wiring, outlets, breakers, lighting, and accessories.</p></div>
    </div>

    <div id="plumbing" class="tab-content">
      <div class="card"><h3>Plumbing Materials</h3><p>Pipes, fittings, fixtures, and repair essentials.</p></div>
    </div>
  </section>

  <script>
    function openTab(evt, tabId) {
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      evt.currentTarget.classList.add('active');
    }
  </script>

  <style>
    .tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }

    .tab {
      padding: 0.5rem 1rem;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      background: white;
      cursor: pointer;
      font-weight: 500;
    }

    .tab.active {
      background: var(--accent);
      border-color: var(--accent);
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>

  <section id="services">
    <h2>Services</h2>
    <div class="grid">
      <div class="card">
        <h3>Expert Advice</h3>
        <p>Our knowledgeable staff helps you choose the right materials for your project.</p>
      </div>
      <div class="card">
        <h3>Special Orders</h3>
        <p>Need something specific? We can order specialty items quickly and reliably.</p>
      </div>
      <div class="card">
        <h3>Local Delivery</h3>
        <p>Convenient delivery options to keep your project moving without delays.</p>
      </div>
    </div>
  </section>

  <section id="about">
    <div class="about">
      <h2>About Norton Hardware</h2>
      <p>
        Norton Hardware has been helping our community since 2026, committed to integrity, fair prices, and dependable service from day one. We believe in fair prices,
        dependable products, and building long-term relationships with our customers.
      </p>
      <p>
        Whether you're a professional contractor or a weekend DIYer, we're here to support your work
        with tools and materials you can trust.
      </p>
    </div>
  </section>

  <section id="contact">
    <h2>Contact Us</h2>
    <div class="grid">
      <div class="card">
        <h3>Visit Our Store</h3>
        <p>123 Main Street<br>Norton, USA</p>
      </div>
      <div class="card">
        <h3>Call Us</h3>
        <p>(555) 123-4567</p>
      </div>
      <div class="card">
        <h3>Email</h3>
        <p>info@nortonhardware.com</p>
      </div>
    </div>
  </section>

  <footer>
    <p>&copy; 2026 <strong>Norton Hardware</strong>. All rights reserved.</p>
  </footer>

</body>
</html>
