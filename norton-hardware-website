<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jellico Hardware</title>

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f3f3;
  }

  header {
    background: #2f5d3a;
    color: white;
    padding: 20px;
    text-align: center;
  }

  .container {
    max-width: 900px;
    margin: auto;
    padding: 20px;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tab {
    padding: 10px 16px;
    border: none;
    background: #ddd;
    cursor: pointer;
    font-weight: bold;
    border-radius: 5px;
  }

  .tab.active {
    background: #2f5d3a;
    color: white;
  }

  .section {
    display: none;
    background: white;
    padding: 20px;
    border-radius: 8px;
  }

  .section.active {
    display: block;
  }

  label {
    display: block;
    margin: 10px 0;
  }

  footer {
    margin-top: 40px;
    text-align: center;
    color: #666;
    font-size: 14px;
  }
</style>
</head>

<body>

<header>
  <h1>Jellico Hardware</h1>
  <p>Daily Store Checklist</p>
</header>

<div class="container">

  <div class="tabs">
    <button class="tab active" onclick="openTab('lumber')">Lumber</button>
    <button class="tab" onclick="openTab('tools')">Tools</button>
    <button class="tab" onclick="openTab('fasteners')">Fasteners</button>
    <button class="tab" onclick="openTab('electrical')">Electrical</button>
    <button class="tab" onclick="openTab('plumbing')">Plumbing</button>
    <button class="tab" onclick="openTab('paint')">Paint</button>
  </div>

  <div id="lumber" class="section active">
    <h2>Lumber</h2>
    <label><input type="checkbox"> 2x4 & 2x6 stocked</label>
    <label><input type="checkbox"> Plywood organized</label>
    <label><input type="checkbox"> Treated lumber checked</label>
  </div>

  <div id="tools" class="section">
    <h2>Tools</h2>
    <label><input type="checkbox"> Power tools charged</label>
    <label><input type="checkbox"> Hand tools organized</label>
  </div>

  <div id="fasteners" class="section">
    <h2>Fasteners</h2>
    <label><input type="checkbox"> Screws stocked</label>
    <label><input type="checkbox"> Nails filled</label>
    <label><input type="checkbox"> Bolts sorted</label>
  </div>

  <div id="electrical" class="section">
    <h2>Electrical</h2>
    <label><input type="checkbox"> Wire inventory checked</label>
    <label><input type="checkbox"> Outlets & switches stocked</label>
  </div>

  <div id="plumbing" class="section">
    <h2>Plumbing</h2>
    <label><input type="checkbox"> PVC fittings stocked</label>
    <label><input type="checkbox"> Pipe organized</label>
  </div>

  <div id="paint" class="section">
    <h2>Paint</h2>
    <label><input type="checkbox"> Paint desk clean</label>
    <label><input type="checkbox"> Brushes & rollers stocked</label>
  </div>

</div>

<footer>
  © Jellico Hardware
</footer>

<script>
  function openTab(tabId) {
    document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.section').forEach(section => section.classList.remove('active'));

    event.target.classList.add('active');
    document.getElementById(tabId).classList.add('active');
  }
</script>

</body>
</html>
